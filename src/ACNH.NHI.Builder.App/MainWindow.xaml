<Window x:Class="ACNH.NHI.Builder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ACNH NHI Builder v0.1.0-alpha" Height="780" Width="1180" MinHeight="650" MinWidth="980"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="ACNH NHI Builder" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock Text="v0.1.0-alpha — lecteur, analyseur et nettoyeur .nhi" Foreground="#666"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Nouveau" Click="New_Click"/>
                <Button Content="Ouvrir .nhi" Click="Open_Click"/>
                <Button Content="Enregistrer sous…" Click="SaveAs_Click"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#D8D8D8" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Générateur visuel" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Prévu pour la prochaine étape" Foreground="#777" Margin="0,2,0,12"/>
                    <TreeView IsEnabled="False">
                        <TreeViewItem Header="Meubles" IsExpanded="True">
                            <TreeViewItem Header="Mobilier"/>
                            <TreeViewItem Header="Petits objets"/>
                            <TreeViewItem Header="Objets muraux"/>
                            <TreeViewItem Header="Plafonniers"/>
                            <TreeViewItem Header="Papiers peints / sols / tapis"/>
                        </TreeViewItem>
                        <TreeViewItem Header="Vêtements" IsExpanded="True">
                            <TreeViewItem Header="Hauts"/>
                            <TreeViewItem Header="Pantalons / jupes"/>
                            <TreeViewItem Header="Robes / tenues"/>
                            <TreeViewItem Header="Chapeaux / accessoires"/>
                            <TreeViewItem Header="Chaussettes / chaussures / sacs"/>
                        </TreeViewItem>
                        <TreeViewItem Header="Matériaux"/>
                        <TreeViewItem Header="Collections spéciales"/>
                        <TreeViewItem Header="Outils / consommables"/>
                    </TreeView>
                    <Separator Margin="0,14"/>
                    <Button Content="Dossier NHSE…" Click="Nhse_Click"/>
                    <Button Content="Presets…" Click="Presets_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" BorderBrush="#D8D8D8" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,10,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                        <TextBlock Text="Contenu du .nhi" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CurrentFileText" Text="Nouvel inventaire" Foreground="#666" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" AlternatingRowBackground="#FAFAFA">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="70"/>
                            <DataGridTextColumn Header="ID" Binding="{Binding ItemId}" Width="95"/>
                            <DataGridTextColumn Header="Qté" Binding="{Binding Quantity}" Width="70"/>
                            <DataGridTextColumn Header="System" Binding="{Binding SystemParam}" Width="80"/>
                            <DataGridTextColumn Header="Additional" Binding="{Binding AdditionalParam}" Width="90"/>
                            <DataGridTextColumn Header="Uses" Binding="{Binding UseCount}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" BorderBrush="#D8D8D8" BorderThickness="1" CornerRadius="7" Padding="14">
                <StackPanel>
                    <TextBlock Text="Analyse" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="CapacityText" Margin="0,12,0,0"/>
                    <TextBlock x:Name="UsedText"/>
                    <TextBlock x:Name="FreeText"/>
                    <TextBlock x:Name="DuplicateText"/>
                    <TextBlock x:Name="UniqueText"/>
                    <Separator Margin="0,14"/>
                    <Button x:Name="CleanButton" Content="Nettoyer les doublons" Click="CleanDuplicates_Click"/>
                    <Button Content="Exporter manifeste CSV" Click="ExportCsv_Click"/>
                    <Separator Margin="0,14"/>
                    <TextBlock Text="Cette alpha conserve les octets de chaque slot lors d'un simple ouvrir → enregistrer. Les noms, images, catégories et variantes arriveront avec l'adaptateur NHSE." TextWrapping="Wrap" Foreground="#666"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="StatusText" FontWeight="SemiBold"/>
                <ProgressBar x:Name="SlotProgress" Height="14" Minimum="0" Maximum="9000" Margin="0,6,20,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Générer / enregistrer .nhi" FontWeight="SemiBold" Click="SaveAs_Click" VerticalAlignment="Bottom"/>
        </Grid>
    </Grid>
</Window>
