<Window x:Class="ACNH.NHI.Builder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ACNH NHI Builder v0.2.1-alpha"
        Height="700" Width="1200" MinHeight="500" MinWidth="820"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ACNH NHI Builder" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="  v0.2.1 alpha" Foreground="{StaticResource CyanBrush}" FontSize="14" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                    </StackPanel>
                    <TextBlock Text="Catalogue NHSE → sélection visuelle → génération .nhi"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="13"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Nouveau" Click="New_Click"/>
                    <Button Content="Ouvrir .nhi" Click="Open_Click"/>
                    <Button Content="Enregistrer sous…" Click="SaveAs_Click"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22*" MinWidth="180"/>
                <ColumnDefinition Width="54*" MinWidth="330"/>
                <ColumnDefinition Width="24*" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,8,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Source NHSE" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="NhseStatusText" Text="Aucun dossier NHSE chargé"
                                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <Button Content="Choisir / recharger NHSE…" Click="Nhse_Click" Style="{StaticResource CyanButtonStyle}"/>
                        <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="8" Margin="4,6,4,8">
                            <TextBlock x:Name="AdapterStatusText" Text="Charge NHSE pour activer le catalogue."
                                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="Recherche" FontWeight="SemiBold" Margin="4,2,0,0"/>
                        <TextBox x:Name="SearchBox" ToolTip="Nom français ou ID (ex. 0x0104)"
                                 TextChanged="SearchBox_TextChanged" IsEnabled="False"/>
                        <CheckBox x:Name="HideInternalCheckBox" IsChecked="True"
                                  Checked="CatalogFilter_Changed" Unchecked="CatalogFilter_Changed">
                            <TextBlock Text="Masquer interne / debug" TextWrapping="Wrap"/>
                        </CheckBox>
                        <CheckBox x:Name="HideInvalidCheckBox" IsChecked="True"
                                  Checked="CatalogFilter_Changed" Unchecked="CatalogFilter_Changed">
                            <TextBlock Text="Masquer entrées invalides" TextWrapping="Wrap"/>
                        </CheckBox>
                        <Separator Margin="0,8"/>
                        <TextBlock Text="Catégories" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    </StackPanel>

                    <TreeView x:Name="CategoryTree" IsEnabled="False" SelectedItemChanged="CategoryTree_SelectedItemChanged">
                        <TreeViewItem Header="Tout le catalogue" Tag="*"/>
                        <TreeViewItem Header="Meubles" Tag="Meubles" IsExpanded="True">
                            <TreeViewItem Header="Mobilier" Tag="Meubles|Mobilier"/>
                            <TreeViewItem Header="Objets muraux" Tag="Meubles|Objets muraux"/>
                            <TreeViewItem Header="Papiers peints" Tag="Meubles|Papiers peints"/>
                            <TreeViewItem Header="Sols" Tag="Meubles|Sols"/>
                            <TreeViewItem Header="Tapis" Tag="Meubles|Tapis"/>
                            <TreeViewItem Header="Piliers / comptoirs" Tag="Meubles|Piliers / comptoirs"/>
                        </TreeViewItem>
                        <TreeViewItem Header="Vêtements" Tag="Vêtements" IsExpanded="True">
                            <TreeViewItem Header="Hauts" Tag="Vêtements|Hauts"/>
                            <TreeViewItem Header="Pantalons / jupes" Tag="Vêtements|Pantalons / jupes"/>
                            <TreeViewItem Header="Robes / tenues" Tag="Vêtements|Robes / tenues"/>
                            <TreeViewItem Header="Chapeaux" Tag="Vêtements|Chapeaux"/>
                            <TreeViewItem Header="Accessoires" Tag="Vêtements|Accessoires"/>
                            <TreeViewItem Header="Chaussettes" Tag="Vêtements|Chaussettes"/>
                            <TreeViewItem Header="Chaussures" Tag="Vêtements|Chaussures"/>
                            <TreeViewItem Header="Sacs" Tag="Vêtements|Sacs"/>
                            <TreeViewItem Header="Parapluies" Tag="Vêtements|Parapluies"/>
                        </TreeViewItem>
                        <TreeViewItem Header="Matériaux" Tag="Matériaux" IsExpanded="True">
                            <TreeViewItem Header="Matériaux / saisonniers" Tag="Matériaux|Matériaux / saisonniers"/>
                            <TreeViewItem Header="Fruits / légumes / graines" Tag="Matériaux|Fruits / légumes / graines"/>
                        </TreeViewItem>
                        <TreeViewItem Header="Collections spéciales" Tag="Collections spéciales" IsExpanded="True">
                            <TreeViewItem Header="Photos" Tag="Collections spéciales|Photos"/>
                            <TreeViewItem Header="Gyroïdes" Tag="Collections spéciales|Gyroïdes"/>
                            <TreeViewItem Header="Art authentique" Tag="Collections spéciales|Art authentique"/>
                            <TreeViewItem Header="Musiques" Tag="Collections spéciales|Musiques"/>
                            <TreeViewItem Header="Posters" Tag="Collections spéciales|Posters"/>
                            <TreeViewItem Header="Modèles poissons / insectes" Tag="Collections spéciales|Modèles poissons / insectes"/>
                        </TreeViewItem>
                        <TreeViewItem Header="Outils / consommables" Tag="Outils / consommables"/>
                        <TreeViewItem Header="Recettes" Tag="Recettes"/>
                        <TreeViewItem Header="Nature" Tag="Nature"/>
                        <TreeViewItem Header="Autres" Tag="Autres"/>
                    </TreeView>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,8,0">
                <TabControl x:Name="MainTabs">
                    <TabItem Header="Catalogue NHSE">
                        <Border Background="{StaticResource PanelBrush}" Padding="6">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="Sélection des objets" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="CatalogCountText" Text="Charge NHSE pour afficher les objets."
                                                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,3,0,0">
                                        <Button Content="Tout visible" Click="SelectVisible_Click"/>
                                        <Button Content="Effacer sélection" Click="ClearSelection_Click"/>
                                    </WrapPanel>
                                </Grid>

                                <DataGrid x:Name="CatalogGrid" AutoGenerateColumns="False" IsReadOnly="False"
                                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal" SelectionMode="Single"
                                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="✓" Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="42"/>
                                        <DataGridTemplateColumn Header="Aperçu" Width="68" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid Width="50" Height="50" Margin="2">
                                                        <Border Background="{StaticResource PanelAltBrush}" CornerRadius="7"/>
                                                        <Image Source="{Binding Sprite}" Stretch="Uniform" Margin="4"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="ID" Binding="{Binding IdText}" Width="78" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Catégorie" Binding="{Binding Category}" Width="115" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Sous-catégorie" Binding="{Binding Subcategory}" Width="150" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Pile max" Binding="{Binding MaxStack}" Width="75" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </TabItem>

                    <TabItem Header="Inventaire .nhi">
                        <Border Background="{StaticResource PanelBrush}" Padding="6">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBlock Text="Contenu du fichier .nhi" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CurrentFileText" Text="Nouvel inventaire non enregistré"
                                               Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal" EnableRowVirtualization="True"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="60"/>
                                        <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="2*"/>
                                        <DataGridTextColumn Header="ID" Binding="{Binding ItemId}" Width="85"/>
                                        <DataGridTextColumn Header="Qté" Binding="{Binding Quantity}" Width="60"/>
                                        <DataGridTextColumn Header="Catégorie" Binding="{Binding Category}" Width="125"/>
                                        <DataGridTextColumn Header="System" Binding="{Binding SystemParam}" Width="70"/>
                                        <DataGridTextColumn Header="Additional" Binding="{Binding AdditionalParam}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </TabItem>
                </TabControl>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Génération" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SelectedCountText" Text="0 objet sélectionné" Foreground="{StaticResource CyanBrush}" Margin="0,4,0,8"/>

                        <TextBlock Text="Preset de sélection" FontWeight="SemiBold"/>
                        <ComboBox x:Name="PresetComboBox" SelectedIndex="0">
                            <ComboBoxItem Content="Tout le catalogue" Tag="*"/>
                            <ComboBoxItem Content="Tous les meubles" Tag="Meubles"/>
                            <ComboBoxItem Content="Tous les vêtements" Tag="Vêtements"/>
                            <ComboBoxItem Content="Tous les matériaux" Tag="Matériaux"/>
                            <ComboBoxItem Content="Collections spéciales" Tag="Collections spéciales"/>
                            <ComboBoxItem Content="Outils / consommables" Tag="Outils / consommables"/>
                            <ComboBoxItem Content="Photos" Tag="Collections spéciales|Photos"/>
                            <ComboBoxItem Content="Gyroïdes" Tag="Collections spéciales|Gyroïdes"/>
                            <ComboBoxItem Content="Art authentique" Tag="Collections spéciales|Art authentique"/>
                        </ComboBox>
                        <Button Content="Appliquer le preset" Click="ApplyPreset_Click" Style="{StaticResource CyanButtonStyle}"/>

                        <Separator Margin="0,8"/>
                        <TextBlock Text="Quantités" FontWeight="SemiBold"/>
                        <CheckBox x:Name="UseMaxStackCheckBox" IsChecked="True">
                            <TextBlock Text="Utiliser la pile maximale quand possible" TextWrapping="Wrap"/>
                        </CheckBox>
                        <Grid Margin="4,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Nombre de piles / exemplaires :" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="StackCopiesBox" Text="1" Width="52" HorizontalContentAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                        <CheckBox x:Name="SkipExistingCheckBox" IsChecked="True">
                            <TextBlock Text="Ignorer les IDs déjà présents" TextWrapping="Wrap"/>
                        </CheckBox>

                        <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="7" Padding="8" Margin="4,6">
                            <TextBlock Text="Les couleurs qui sont des IDs distincts dans NHSE sont déjà sélectionnables séparément. Les variantes de corps/personnalisations avancées seront ajoutées après validation de ce générateur."
                                       TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                        </Border>

                        <Button Content="Ajouter la sélection au .nhi" Click="AddSelected_Click" Style="{StaticResource AccentButtonStyle}"/>

                        <Separator Margin="0,10"/>
                        <TextBlock Text="Analyse du .nhi" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CapacityText" Margin="0,6,0,0"/>
                        <TextBlock x:Name="UsedText"/>
                        <TextBlock x:Name="FreeText"/>
                        <TextBlock x:Name="DuplicateText"/>
                        <TextBlock x:Name="UniqueText"/>

                        <Button x:Name="CleanButton" Content="Nettoyer les doublons stricts" Click="CleanDuplicates_Click" Margin="4,8,4,2"/>
                        <Button Content="Exporter manifeste CSV" Click="ExportCsv_Click"/>
                        <Button Content="Générer / enregistrer .nhi" Click="SaveAs_Click" Style="{StaticResource AccentButtonStyle}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="StatusText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar x:Name="SlotProgress" Minimum="0" Maximum="9000" Margin="0,5,12,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="GPL-3.0 • données chargées depuis votre installation NHSE"
                           ToolTip="GPL-3.0 • données chargées depuis votre installation NHSE"
                           MaxWidth="320" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>